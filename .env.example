# Copy this file to .env and fill in real values as needed.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zentra?schema=public"

# Public base URL used for provider redirect/callback URLs.
APP_URL="http://localhost:3000"

# Safaricom Daraja (M-Pesa). Leave blank to use the simulated STK flow.
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_ENVIRONMENT="sandbox"

# PayPal Orders API v2. Leave blank to use manual reference verification.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_CURRENCY="USD"
